# Copy this file to `.env` before starting the app, then edit as needed.
# Most people can leave everything as-is. Settings that are safe to change if needed are
# explained below — you don't need to understand every line.

# Folders on this computer where scans go in and results come out.
INPUT_DIR=./data/inputs
OUTPUT_DIR=./data/outputs

# The address used to open the app in a browser. Leave as "localhost" if you're only using
# the app on this computer. If you need access from different machines on the network, 
# put this machine's IP address
HOST_IP=localhost

# Each part of the app uses its own port on this computer. The defaults below
# should work fine — only change one if you see a "port is already in use" error when
# starting the app, and make sure no two lines below use the same number.
FRONTEND_PORT=5000
BACKEND_PORT=5001
ORTHANC_HTTP_PORT=5002
MONGO_EXPRESS_PORT=5003
MONGO_PORT=5004
REDIS_PORT=5005
ORTHANC_DICOM_PORT=5006

# Worked out automatically from the settings above — no need to change this.
VITE_BACKEND_URI=https://${HOST_IP}:${BACKEND_PORT}

# How many scans can be processed at once. Higher numbers finish scans faster but need a
# more capable computer. Only raise NUM_GPU_WORKERS if this computer has more than one
# graphics card (GPU) — otherwise extra GPU workers won't help.
NUM_GPU_WORKERS=1
NUM_CPU_WORKERS=2

# Turns on extra logging to help diagnose problems. Safe to leave on — this only affects
# what gets written to the server's own logs, not anything shown to users.
FLASK_DEBUG=True

# Username and password for the app's database. The defaults are fine if you're the only
# person with access to this computer. Change them if it's a shared computer or reachable
# by other people on your network.
MONGO_INITDB_ROOT_USERNAME=abc-user
MONGO_INITDB_ROOT_PASSWORD=abc-toolkit
MONGO_INITDB_DATABASE=db

# Login for a technical database-browsing tool most users won't need. Same guidance as
# above — change the password if this computer isn't just for you.
MONGOEXPRESS_LOGIN=dev
MONGOEXPRESS_PASSWORD=dev

# Login for Orthanc, the built-in server that receives scans sent from a scanner or PACS,
# and its viewer page. Same guidance as above — change the password if this computer isn't
# just for you.
ORTHANC_USER=abc-user
ORTHANC_PASSWORD=abc-toolkit
